generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

/// Tabela: congregacao
model Congregacao {
  idCongregacao Int            @id @default(autoincrement()) @map("id_congregacao")
  nome          String         @db.VarChar(150)
  endereco      String?        @db.VarChar(255)
  movimentacoes Movimentacao[]
  usuarios      Usuario[]

  @@map("congregacao")
}

/// Tabela: usuario
model Usuario {
  id                 Int            @id @default(autoincrement()) @map("id_usuario")
  congregacaoId      Int?           @map("id_congregacao")
  nome               String         @db.VarChar(100)
  email              String         @unique @db.VarChar(150)
  senha              String         @db.VarChar(255)
  perfil             String?        @default("USER") @db.VarChar(20)
  ativo              Boolean?       @default(false)
  verification_token String?
  isVerified         Boolean?       @default(false) @map("is_verified")
  resetToken         String?        @map("reset_token")
  movimentacoes      Movimentacao[]
  congregacao        Congregacao?   @relation(fields: [congregacaoId], references: [idCongregacao], onDelete: Cascade, onUpdate: NoAction)

  @@map("usuario")
}

/// Tabela: movimentacao
model Movimentacao {
  id            Int         @id @default(autoincrement()) @map("id_mov")
  congregacaoId Int         @map("id_congregacao")
  usuarioId     Int?        @map("id_usuario")
  descricao     String?     @db.VarChar(255)
  valor         Decimal     @db.Decimal(10, 2)
  data          DateTime    @db.Date
  tipo          String      @db.VarChar(20)
  dataRegistro  DateTime?   @default(now()) @map("data_registro") @db.Timestamp(6)
  congregacao   Congregacao @relation(fields: [congregacaoId], references: [idCongregacao], onDelete: Cascade, onUpdate: NoAction)
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id], onUpdate: NoAction)

  @@map("movimentacao")
}
